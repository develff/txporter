# ---------------------------------------------------------------
# Firefly III
# ---------------------------------------------------------------

# 32-character random key — generate with:
#   openssl rand -base64 24
APP_KEY=change_me_to_32_random_characters

# PostgreSQL password (choose freely)
POSTGRES_PASSWORD=change_me_db_password

# Firefly III personal access token — generate in Firefly III UI after first login:
#   Profile → OAuth → Personal Access Tokens → Create New Token
# Also set this as "token" in config/banks.json targets.firefly
FIREFLY_TOKEN=

# ---------------------------------------------------------------
# txporter
# ---------------------------------------------------------------

# How long (seconds) an aqbanking-cli process may run before it is
# considered stale and killed automatically on the next sync attempt.
# Lower this temporarily (e.g. 10) to test the auto-kill behaviour.
# Default: 300
#TXPORTER_STALE_PROC_TIMEOUT=300
